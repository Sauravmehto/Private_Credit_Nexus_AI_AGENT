# Copy to .env and fill in your values (never commit .env).

# Required for portfolio / deal tools and audit DB writes
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/private_credit?retryWrites=true&w=majority

# FastAPI chat API (api/main.py) — required for POST /chat
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE
# Primary model id (Anthropic). Optional alias: CLAUDE_MODEL (same value if you prefer that name).
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Optional fallback providers (used in order: Anthropic -> OpenAI -> Gemini -> Groq)
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_KEY
OPENAI_MODEL=gpt-4o-mini

# Preferred variable name is GEMINI_API_KEY (legacy alias Gemin_API_Key is also supported).
GEMINI_API_KEY=YOUR_GEMINI_KEY
GEMINI_MODEL=gemini-1.5-flash
Gemin_Client_ID=YOUR_GEMINI_CLIENT_ID

GROQ_API_KEY=gsk_YOUR_GROQ_KEY
GROQ_MODEL=llama-3.1-8b-instant

# Optional
LOG_LEVEL=info

# Comma-separated origins for browser UI — add your Netlify URL here after deploying
CORS_ALLOW_ORIGINS=http://localhost:5173,https://YOUR-APP.netlify.app
